# Bu dosyayı ".env" adıyla kopyalayıp doldurun. ".env" git'e EKLENMEZ (.gitignore'da).

# --- Telegram (zorunlu, DRY_RUN hariç) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Supabase (zorunlu, DRY_RUN hariç) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (İSTEĞE BAĞLI) ---
# Yalnızca kural motorunun emin olamadığı haberler için kullanılır. Boş bırakırsanız bot tamamen ücretsiz çalışır.
GEMINI_API_KEY=
AI_MODEL_NAME=
MAX_GEMINI_CALLS_PER_RUN=3

# --- Ayarlar (hepsi isteğe bağlı) ---
# Bu skorun altındaki haberler yayınlanmaz (varsayılan 50)
MIN_CONFIDENCE=50
# Bundan eski öğeler işlenmez (saat)
MAX_ITEM_AGE_HOURS=3
# Sürekli modda (npm start) tarama aralığı
SCAN_INTERVAL_SECONDS=300
# 1 = Telegram'a göndermez, veritabanına yazmaz, mesajları ekrana basar
DRY_RUN=0

# --- X / Twitter (VARSAYILAN KAPALI, bkz. README) ---
# NITTER_INSTANCES=https://sunucu1.example,https://sunucu2.example
# ENABLE_X_RAPIDAPI=1
# RAPIDAPI_KEY=
